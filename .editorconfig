root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.swift]
indent_size = 4

[*.py]
indent_size = 4
max_line_length = 120

[*.{yml,yaml,json,jsonl,toml}]
indent_size = 2

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

[*.{jsonl,plist}]
insert_final_newline = false
